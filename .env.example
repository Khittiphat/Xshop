# Server Port & Host Binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Persistence Options
# Option 1: File path
DB_PATH=./data/xmart.db

# Option 2: Cloud volume mount directory (auto-resolves to $DATA_DIR/xmart.db)
# DATA_DIR=/data

# Option 3: Standard database URL
# DATABASE_URL=sqlite:///data/xmart.db
