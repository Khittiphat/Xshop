{
  "name": "x-mart-backend",
  "version": "1.0.0",
  "description": "Convenience store e-commerce backend prototype with zero-config SQLite",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/database/init.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "node src/database/setup.js",
    "db:verify": "node src/database/verify.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ecommerce",
    "express",
    "sqlite",
    "better-sqlite3",
    "convenience-store"
  ],
  "author": "X Mart Team",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
